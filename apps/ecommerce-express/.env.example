# .env.example (ecommerce-express) => plantilla versionada; copiar a .env (nunca se sube a git)
# Hosts para correr con "pnpm dev" en tu equipo (localhost). En Docker, docker-compose.dev.yml los reemplaza por los nombres de servicio.
# Validado al arrancar por src/config/app.config.ts (Zod): si falta algo obligatorio el proceso no inicia.

PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Persistencia ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecommerce_db
MONGO_URL=mongodb://localhost:27017/ecommerce_docs
REDIS_URL=redis://localhost:6379

# --- JWT (mínimo 16 caracteres; en producción, secretos aleatorios de 64+) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Correo (Mailpit/MailHog en desarrollo: SMTP 1025, UI en 8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eCommerce Web3 <no-reply@ecommerce-web3.dev>"

# --- Comercio ---
DEFAULT_CURRENCY=COP
TAX_RATE=0.19
CHECKOUT_TTL_MINUTES=30
CART_TTL_DAYS=30
LOYALTY_POINTS_PER_UNIT=100000

# --- Stripe (claves de prueba sk_test_ / whsec_ del dashboard o de "stripe listen") ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (cloudinary://API_KEY:API_SECRET@CLOUD_NAME) ---
CLOUDINARY_URL=

# --- Revalidación ISR bajo demanda del storefront (Next.js /api/revalidate); vacío = solo expiración por tiempo ---
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Mismo valor que REVALIDATE_SECRET en apps/ecommerce-next/.env (mínimo 16 caracteres)
REVALIDATE_SECRET=change-me-revalidate-secret

# --- Motor IA (FastAPI) para búsqueda por imagen ---
FASTAPI_URL=http://localhost:8000

# --- Facturación electrónica DIAN (ambiente 2 = habilitación/pruebas) ---
DIAN_INVOICE_PREFIX=SETP
DIAN_TECHNICAL_KEY=fc8eac422eba16e22ffd8c6f94b3f40a6e38162c
DIAN_SELLER_NIT=900000000
DIAN_ENVIRONMENT=2

# --- Web3: NFT badges de fidelidad (ERC-721 con safeMint) + IPFS ---
WEB3_RPC_URL=
WEB3_PRIVATE_KEY=
NFT_CONTRACT_ADDRESS=
IPFS_API_URL=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs

# --- Push (Firebase Cloud Messaging HTTP v1, cuenta de servicio) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Seed ---
SEED_ADMIN_EMAIL=admin@ecommerce.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_VENDOR_EMAIL=vendedor@ecommerce.local
SEED_VENDOR_PASSWORD=Vendedor12345!
SEED_CUSTOMER_EMAIL=cliente@ecommerce.local
SEED_CUSTOMER_PASSWORD=Cliente12345!

# --- Azure (OPCIONAL — apagado por defecto) ---
# Con AZURE_ENABLED=false (o vacío) el proyecto usa SOLO alternativas gratuitas:
#   secretos -> este .env · correo -> SMTP/Mailpit · monitoreo -> logs de winston
# Con AZURE_ENABLED=true se usa cada servicio de Azure que tenga credenciales; si alguno falla, se vuelve al gratuito.
AZURE_ENABLED=false
# Key Vault: los secretos "JWT-ACCESS-SECRET" se cargan como JWT_ACCESS_SECRET (Managed Identity o "az login")
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=
